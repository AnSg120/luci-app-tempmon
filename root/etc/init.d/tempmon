#!/bin/sh /etc/rc.common
# luci-app-tempmon: temperature & CPU info sample collector (procd service)

USE_PROCD=1
START=99
STOP=10

start_service() {
	local enabled
	enabled="$(uci -q get tempmon.core.enabled)"
	[ "${enabled:-1}" = "1" ] || return 0

	procd_open_instance
	procd_set_param command /usr/libexec/tempmon/collect.sh
	procd_set_param respawn 3600 5 5
	# NOTE: no procd_set_param file here — the collector re-reads every UCI
	# option at the top of each sampling loop (refresh_config), so config
	# changes apply live without restarting the service; a file trigger would
	# restart it even for display-only options like hide_items.
	procd_close_instance
}